---
import BaseLayout from './BaseLayout.astro'
import InformationHero from '../components/atoms/InformationHero.astro'
import Post from '../components/organisms/Post.astro'
import Pagination from '../components/organisms/Pagination.astro'
import type { PostSummary } from '../lib/posts'

interface Props {
  title: string
  date: string
  description?: string | undefined
  previous: PostSummary | null
  next: PostSummary | null
}

const { title, date, description, previous, next } = Astro.props
---
<BaseLayout title={title} description={description}>
  <InformationHero />
  <Post title={title} date={date}>
    <slot />
  </Post>
  <Pagination previous={previous} next={next} />
</BaseLayout>
