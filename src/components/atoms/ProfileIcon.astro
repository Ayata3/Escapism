---
import { Image } from 'astro:assets'
import profileIcon from '../../images/profile_icon.jpg'
---

<div class="float-right mt-2 mr-8">
  <Image
    src={profileIcon}
    class="rounded-full border-2 border-gray-100 bg-blue-700 h-24 w-24 lg:h-40 xl:h-40 lg:w-40 xl:w-40"
    alt="プロフィール画像"
    width={160}
    height={160}
  />
</div>
